; Engine configuration file.
config_version=5

[application]
config/name="Be the Knight"
; Keep existing saves, settings and authored user levels after the title change.
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Summit"
config/custom_user_dir_name.linux="godot/app_userdata/Summit"
config/custom_user_dir_name.freebsd="godot/app_userdata/Summit"
config/custom_user_dir_name.netbsd="godot/app_userdata/Summit"
config/custom_user_dir_name.openbsd="godot/app_userdata/Summit"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4")

[autoload]
Game="*res://scripts/game.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[debug]

file_logging/max_log_files=30
